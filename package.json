{
	"name": "sythe-bumper",
	"version": "2.0.0",
	"description": "Sythe forum auto-bumper and thread editor",
	"type": "module",
	"module": "src/index.ts",
	"private": true,
	"scripts": {
		"gentypes": "bun run src/lib/types/update.ts",
		"start": "bun src/index.ts",
		"dev": "bun --watch src/index.ts",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"fix": "prettier --write . && eslint . --fix"
	},
	"keywords": [],
	"author": "Torwent",
	"license": "LGPL-3.0-or-later",
	"dependencies": {
		"@supabase/supabase-js": "^2.58.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@types/bun": "^1.3.0",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0"
	}
}
